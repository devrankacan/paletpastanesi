# --- docker compose (VPS deploy) için ---
# db container'ının kullanıcı/şifre/veritabanı adı. docker-compose.yml
# bunlardan DATABASE_URL'i otomatik oluşturur (app container'ı "db" host'una bağlanır).
POSTGRES_USER="palet"
POSTGRES_PASSWORD="guclu-bir-sifre-belirle"
POSTGRES_DB="palet"

# Sitenin VPS üzerinde hangi host portunda yayınlanacağı (Nginx bu porta
# reverse proxy yapacak). Sunucuda boş olan bir port seç.
APP_PORT="3010"

# --- Yerel geliştirme (docker olmadan, npm run dev) için ---
# Yukarıdaki POSTGRES_* değerleriyle uyumlu, localhost'a bağlanan bağlantı.
# docker compose kullanıyorsan bu satır app container'ı için kullanılmaz,
# üstteki POSTGRES_* değerlerinden otomatik üretilir.
DATABASE_URL="postgresql://palet:guclu-bir-sifre-belirle@localhost:5432/palet"

# NextAuth için rastgele bir gizli anahtar (örn: `openssl rand -hex 32`)
AUTH_SECRET=""

# Seed script'inin oluşturacağı admin kullanıcısı
ADMIN_EMAIL="admin@paletpastanesi.com"
ADMIN_PASSWORD="degistir123"

# iyzico (https://merchant.iyzipay.com) — boş bırakılırsa site "test modu"nda
# çalışır ve gerçek ödeme alınmaz.
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
